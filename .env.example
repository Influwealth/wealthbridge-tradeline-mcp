# WealthBridge Tradeline MCP - Environment Configuration
# Copy to .env and fill with your actual credentials

# Credit Bureau APIs
EXPERIAN_API_KEY=your_experian_key_here
EXPERIAN_BASE_URL=https://api.experian.com/business/v1
EXPERIAN_CLIENT_ID=your_client_id
EXPERIAN_CLIENT_SECRET=your_client_secret

EQUIFAX_API_KEY=your_equifax_key_here
EQUIFAX_BASE_URL=https://api.equifax.com/business/v1

DUNS_API_KEY=your_dun_bradstreet_key_here
DUNS_BASE_URL=https://api.dnb.com/v1

# Payment Processors (for tradeline reporting)
STRIPE_API_KEY=your_stripe_key
STRIPE_SECRET_KEY=your_stripe_secret

# Alternative Data Providers
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # sandbox, development, or production

# Internal Federal API Integration
FEDERAL_VAULT_URL=http://localhost:8000
FEDERAL_VAULT_API_KEY=your_vault_key

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/wealthbridge_tradeline
# Or SQLite for development
# DATABASE_URL=sqlite:///data/tradeline.db

# Redis (for caching and job queue)
REDIS_URL=redis://localhost:6379/0

# Application Settings
ENVIRONMENT=development  # development, staging, production
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-base64

# Tradeline Reporting
AUTO_REPORT_ENABLED=true
REPORT_FREQUENCY_DAYS=30
MINIMUM_PAYMENT_AMOUNT=100.00
MINIMUM_ACCOUNT_AGE_DAYS=90

# Credit Scoring
SCORING_MODEL=wealthbridge_v1  # proprietary scoring algorithm
WEIGHT_PAYMENT_HISTORY=35
WEIGHT_CREDIT_UTILIZATION=30
WEIGHT_CREDIT_AGE=15
WEIGHT_CREDIT_MIX=10
WEIGHT_NEW_CREDIT=10

# Compliance
DATA_RETENTION_DAYS=2555  # 7 years (regulatory requirement)
PII_ENCRYPTION_ENABLED=true
AUDIT_LOG_ENABLED=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_TRADELINE_PULLS_PER_DAY=50

# Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@influwealth.com
SMTP_PASSWORD=your_email_password
ALERT_EMAIL=admin@influwealth.com

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=INFO
LOG_FILE=logs/tradeline.log

# Feature Flags
ENABLE_MANUAL_TRADELINE_CREATION=true
ENABLE_FEDERAL_CONTRACT_TRACKING=true
ENABLE_AI_CREDIT_RECOMMENDATIONS=true
ENABLE_VENDOR_CREDIT_PROGRAM=false
